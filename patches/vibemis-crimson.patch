diff --git a/app/gui/CrimsonStatusDialog.qml b/app/gui/CrimsonStatusDialog.qml
new file mode 100644
index 00000000..6870f9c3
--- /dev/null
+++ b/app/gui/CrimsonStatusDialog.qml
@@ -0,0 +1,90 @@
+import QtQuick 2.9
+import QtQuick.Controls 2.5
+import QtQuick.Layouts 1.3
+import QtQuick.Controls.Material 2.2
+import Vibemis.Redesign 1.0
+import CrimsonStatus 1.0
+
+NavigableDialog {
+    id: panel
+    property string kind: "host"
+    width: Math.min(620, parent.width - 32)
+    height: Math.min(kind === "host" ? 650 : 280, parent.height - 32)
+    title: kind === "host" ? qsTr("Vibepollo • Host hardware") : kind === "network" ? qsTr("Network status") : qsTr("Battery status")
+    standardButtons: Dialog.Close
+    Material.background: VbTokens.bgElev
+    Material.accent: VbTokens.accent
+    background: Rectangle { color: VbTokens.bgElev; radius: VbTokens.radiusDialog; border.color: VbTokens.stroke; border.width: 1 }
+    onOpened: {
+        urlInput.text = CrimsonStatus.endpoint
+        pinInput.text = CrimsonStatus.fingerprint
+        tokenInput.text = ""
+        CrimsonStatus.setVisible(kind === "host")
+    }
+    onClosed: { CrimsonStatus.setVisible(false); tokenInput.text = ""; stackView.forceActiveFocus() }
+    function metric(key, suffix) {
+        var n = CrimsonStatus.stats[key]
+        return n === undefined ? qsTr("N/A") : Number(n).toFixed(1) + suffix
+    }
+    function memory(prefix) {
+        var s = CrimsonStatus.stats
+        return s[prefix + "_used_bytes"] === undefined || !s[prefix + "_total_bytes"] ? qsTr("N/A")
+             : (s[prefix + "_used_bytes"] / 1073741824).toFixed(1) + " / " + (s[prefix + "_total_bytes"] / 1073741824).toFixed(1) + " GiB"
+    }
+    contentItem: ScrollView {
+        clip: true
+        contentWidth: availableWidth
+        ColumnLayout {
+            width: panel.availableWidth
+            spacing: VbTokens.space3
+            Label {
+                visible: panel.kind !== "host"
+                Layout.fillWidth: true; wrapMode: Text.Wrap
+                text: panel.kind === "network" ? (CrimsonStatus.local.network + (CrimsonStatus.local.wifiSignal >= 0 ? " • " + CrimsonStatus.local.wifiSignal + "% signal" : "") + "\n" + qsTr("Active link status; internet access is not assumed."))
+                    : (CrimsonStatus.local.batteryPercent >= 0 ? CrimsonStatus.local.batteryPercent + "% • " : "") + CrimsonStatus.local.batteryState
+                color: VbTokens.text; font.pixelSize: VbTokens.typeBody
+            }
+            Label {
+                visible: panel.kind === "host"
+                Layout.fillWidth: true; wrapMode: Text.Wrap
+                text: CrimsonStatus.status
+                color: VbTokens.textDim
+            }
+            Repeater {
+                model: panel.kind === "host" ? [
+                    [qsTr("CPU"), panel.metric("cpu_percent", "%"), panel.metric("cpu_temp_c", " °C")],
+                    [qsTr("RAM"), panel.memory("ram"), panel.metric("ram_percent", "%")],
+                    [qsTr("GPU"), panel.metric("gpu_percent", "%"), panel.metric("gpu_temp_c", " °C")],
+                    [qsTr("VRAM"), panel.memory("vram"), panel.metric("vram_percent", "%")],
+                    [qsTr("GPU encoder"), panel.metric("gpu_encoder_percent", "%"), ""],
+                    [qsTr("Host network"), panel.metric("net_rx_bps", " B/s RX"), panel.metric("net_tx_bps", " B/s TX")]
+                ] : []
+                delegate: Rectangle {
+                    Layout.fillWidth: true; implicitHeight: 58
+                    color: VbTokens.bgWindow; radius: VbTokens.radiusControl
+                    border.color: VbTokens.stroke; border.width: 1
+                    RowLayout {
+                        anchors.fill: parent; anchors.margins: 12
+                        Label { text: modelData[0]; color: VbTokens.textDim; Layout.preferredWidth: 115 }
+                        Label { text: modelData[1]; color: VbTokens.text; Layout.fillWidth: true }
+                        Label { text: modelData[2]; color: VbTokens.accent }
+                    }
+                }
+            }
+            GroupBox {
+                visible: panel.kind === "host"
+                title: qsTr("Configure host stats")
+                Layout.fillWidth: true
+                ColumnLayout {
+                    anchors.fill: parent
+                    Label { Layout.fillWidth: true; wrapMode: Text.Wrap; text: qsTr("Select a host first. Enable realtime stats in Vibepollo and create a read-only token for GET /api/host/stats. GameStream pairing does not grant this access."); color: VbTokens.textDim }
+                    TextField { id: urlInput; Layout.fillWidth: true; placeholderText: qsTr("HTTPS host URL, e.g. https://192.168.1.10:47990"); selectByMouse: true }
+                    TextField { id: tokenInput; Layout.fillWidth: true; placeholderText: qsTr("Read-only API token (blank keeps saved token)"); echoMode: TextInput.Password; selectByMouse: true }
+                    TextField { id: pinInput; Layout.fillWidth: true; placeholderText: qsTr("SHA-256 certificate fingerprint for a self-signed host"); selectByMouse: true }
+                    Label { Layout.fillWidth: true; wrapMode: Text.Wrap; text: qsTr("Verify a self-signed certificate's SHA-256 fingerprint on the host before saving it. Token is stored privately on this USB; it is not encrypted. Unsupported or missing sensors show N/A."); color: VbTokens.textDim }
+                    Button { text: qsTr("Save & connect"); onClicked: { if (CrimsonStatus.configure(urlInput.text, tokenInput.text, pinInput.text)) tokenInput.text = "" } }
+                }
+            }
+        }
+    }
+}
diff --git a/app/gui/EclipseAboutDialog.qml b/app/gui/EclipseAboutDialog.qml
new file mode 100644
index 00000000..f3ffb2c6
--- /dev/null
+++ b/app/gui/EclipseAboutDialog.qml
@@ -0,0 +1,34 @@
+import QtQuick 2.9
+import QtQuick.Controls 2.5
+import QtQuick.Layouts 1.3
+import QtQuick.Controls.Material 2.2
+import Vibemis.Redesign 1.0
+NavigableDialog {
+    id: panel
+    property var info: ({})
+    width: Math.min(520,parent.width-32)
+    title: qsTr("About Eclipse")
+    standardButtons: Dialog.Close
+    Material.background: VbTokens.bgElev
+    Material.accent: VbTokens.accent
+    background: Rectangle { radius: VbTokens.radiusDialog; color: VbTokens.bgElev; border.color: VbTokens.stroke
+        Rectangle { anchors.fill: parent; color: "transparent"; gradient: Gradient { GradientStop { position: 0; color: Qt.rgba(1,1,1,0.035) } GradientStop { position: 1; color: "transparent" } } }
+    }
+    contentItem: ColumnLayout {
+        spacing: VbTokens.space3
+        Image { source: "qrc:/res/eclipse-icon.svg"; sourceSize.width: 96; sourceSize.height: 96; Layout.alignment: Qt.AlignHCenter; Layout.preferredWidth: 96; Layout.preferredHeight: 96 }
+        Label { text: "ECLIPSE"; color: VbTokens.text; font.family: VbTokens.fontDisplay; font.pixelSize: 24; font.letterSpacing: 4; Layout.alignment: Qt.AlignHCenter }
+        Label { text: qsTr("Made by Th3D3ck3r"); color: VbTokens.accent; Layout.alignment: Qt.AlignHCenter }
+        Label {
+            Layout.fillWidth: true; textFormat: Text.PlainText; wrapMode: Text.Wrap; color: VbTokens.textDim
+            text: qsTr("OS: %1 %2\nTarget: %3\nFedora: %4\nKernel: %5\nEclipse frontend: %6 • customized")
+                .arg((panel.info.os || {}).NAME || "Moonlight-OS")
+                .arg((panel.info.os || {}).VERSION || qsTr("Unavailable"))
+                .arg((panel.info.os || {}).TARGET || qsTr("Unavailable"))
+                .arg((panel.info.os || {}).FEDORA || qsTr("Unavailable"))
+                .arg(panel.info.kernel || qsTr("Unavailable"))
+                .arg(Qt.application.version || "0.5.0")
+        }
+        Label { Layout.fillWidth: true; wrapMode: Text.Wrap; color: VbTokens.textDim; text: qsTr("A lightweight Moonlight-OS frontend. Based on Vibemis and Moonlight; original open-source credits and licenses remain available in Settings. Updates are managed by Moonlight-OS.") }
+    }
+}
diff --git a/app/gui/EclipseActionButton.qml b/app/gui/EclipseActionButton.qml
new file mode 100644
index 00000000..63132728
--- /dev/null
+++ b/app/gui/EclipseActionButton.qml
@@ -0,0 +1,32 @@
+import QtQuick 2.9
+import QtQuick.Controls 2.5
+import Vibemis.Redesign 1.0
+Button {
+    id: button
+    property string iconSource: ""
+    implicitHeight: 44
+    implicitWidth: Math.max(100, contentItem.implicitWidth + 28)
+    font.family: VbTokens.fontBody
+    font.pixelSize: VbTokens.typeLabel
+    Accessible.name: text
+    activeFocusOnTab: true
+    Keys.onReturnPressed: if (enabled) clicked()
+    Keys.onEnterPressed: if (enabled) clicked()
+    Keys.onRightPressed: nextItemInFocusChain(true).forceActiveFocus(Qt.TabFocus)
+    Keys.onLeftPressed: nextItemInFocusChain(false).forceActiveFocus(Qt.TabFocus)
+    Keys.onDownPressed: nextItemInFocusChain(true).forceActiveFocus(Qt.TabFocus)
+    Keys.onUpPressed: nextItemInFocusChain(false).forceActiveFocus(Qt.TabFocus)
+    background: Rectangle {
+        radius: VbTokens.radiusControl
+        color: button.down ? VbTokens.bgElev2 : button.hovered ? VbTokens.bgElev2 : VbTokens.bgWindow
+        border.width: button.activeFocus ? 2 : 1
+        border.color: button.activeFocus || button.hovered ? VbTokens.accent : VbTokens.stroke
+        opacity: button.enabled ? 1 : 0.5
+    }
+    contentItem: Row {
+        spacing: 8
+        opacity: button.enabled ? 1 : 0.5
+        Image { visible: button.iconSource !== ""; source: button.iconSource; width: visible ? 20 : 0; height: 20; anchors.verticalCenter: parent.verticalCenter }
+        Label { text: button.text; textFormat: Text.PlainText; color: VbTokens.text; font: button.font; anchors.verticalCenter: parent.verticalCenter }
+    }
+}
diff --git a/app/gui/EclipseControlCenter.qml b/app/gui/EclipseControlCenter.qml
new file mode 100644
index 00000000..c25d15fb
--- /dev/null
+++ b/app/gui/EclipseControlCenter.qml
@@ -0,0 +1,163 @@
+import QtQuick 2.9
+import QtQuick.Controls 2.5
+import QtQuick.Layouts 1.3
+import QtQuick.Controls.Material 2.2
+import Vibemis.Redesign 1.0
+import SystemControls 1.0
+import CrimsonStatus 1.0
+import StreamingPreferences 1.0
+import EclipseProfiles 1.0
+
+Drawer {
+    id: panel
+    edge: Qt.RightEdge
+    width: Math.min(560, parent.width - 24)
+    height: parent.height
+    modal: true
+    enter: Transition { NumberAnimation { property: "position"; from: 0; to: 1; duration: VbTokens.sheetInMs } }
+    exit: Transition { NumberAnimation { property: "position"; from: 1; to: 0; duration: VbTokens.sheetInMs } }
+    property var host: ({})
+    property bool canWake: false
+    property bool canManage: false
+    property string nextPanel: ""
+    property string message: ""
+    property var savedNames: []
+    property string powerAction: ""
+    signal navigateRequested(string destination)
+    signal wakeRequested()
+    Material.theme: Material.Dark
+    Material.background: VbTokens.bgElev
+    Material.accent: VbTokens.accent
+    background: Rectangle { color: VbTokens.bgElev; border.color: VbTokens.stroke
+        Rectangle { anchors.fill: parent; color: "transparent"; gradient: Gradient { GradientStop { position: 0; color: Qt.rgba(1,1,1,0.035) } GradientStop { position: 1; color: "transparent" } } }
+    }
+    function defer(destination) { nextPanel = destination; close() }
+    function apply(values) {
+        if (!values.width) { message = qsTr("Save this profile first."); return }
+        StreamingPreferences.width = values.width
+        StreamingPreferences.height = values.height
+        StreamingPreferences.fps = values.fps
+        StreamingPreferences.bitrateKbps = values.bitrateKbps
+        StreamingPreferences.save()
+        message = qsTr("Profile applied for the next stream.")
+    }
+    onOpened: { message = ""; SystemControls.open("center"); profileName.text = "Gaming"; savedNames = EclipseProfiles.names(host.id || "") }
+    onClosed: {
+        powerDialog.close(); SystemControls.close(); stackView.forceActiveFocus()
+        if (nextPanel !== "") { var destination = nextPanel; nextPanel = ""; navigateRequested(destination) }
+    }
+    contentItem: ColumnLayout {
+        anchors.fill: parent; anchors.margins: 20; spacing: VbTokens.space3
+        RowLayout {
+            Layout.fillWidth: true
+            Label { text: qsTr("Eclipse • Control center"); color: VbTokens.text; font.family: VbTokens.fontDisplay; font.pixelSize: VbTokens.typeBody; Layout.fillWidth: true }
+            EclipseActionButton { text: qsTr("Close"); onClicked: panel.close() }
+        }
+        ScrollView {
+            Layout.fillWidth: true; Layout.fillHeight: true
+            clip: true; contentWidth: availableWidth
+            ColumnLayout {
+                width: parent.width; spacing: VbTokens.space3
+                Label { Layout.fillWidth: true; textFormat: Text.PlainText; wrapMode: Text.Wrap; text: CrimsonStatus.local.network || qsTr("Network unavailable"); color: VbTokens.textDim }
+                Label { Layout.fillWidth: true; text: CrimsonStatus.local.batteryPercent >= 0 ? qsTr("Battery %1% • %2").arg(CrimsonStatus.local.batteryPercent).arg(CrimsonStatus.local.batteryState) : qsTr("Battery unavailable"); color: VbTokens.textDim; wrapMode: Text.Wrap }
+                RowLayout {
+                    EclipseActionButton { text: qsTr("Wi-Fi"); iconSource: "qrc:/res/crimson-network.svg"; onClicked: panel.defer("wifi") }
+                    EclipseActionButton { text: qsTr("Bluetooth"); iconSource: "qrc:/res/crimson-bluetooth.svg"; onClicked: panel.defer("bt") }
+                }
+                Label { text: qsTr("Audio"); color: VbTokens.text; font.bold: true }
+                RowLayout {
+                    Layout.fillWidth: true
+                    Slider {
+                        id: volumeSlider
+                        Layout.fillWidth: true; from: 0; to: 100; stepSize: 1
+                        value: SystemControls.state.volume === undefined || SystemControls.state.volume === null ? 0 : SystemControls.state.volume
+                        enabled: !SystemControls.busy && SystemControls.state.volume !== undefined && SystemControls.state.volume !== null
+                        Accessible.name: qsTr("Speaker volume")
+                        onMoved: if (!pressed && enabled) SystemControls.request("center-volume", String(Math.round(value)))
+                        onPressedChanged: if (!pressed && enabled) SystemControls.request("center-volume", String(Math.round(value)))
+                    }
+                    Label { id: volumeReadout; text: Math.round(volumeSlider.value)+"%"; color: VbTokens.text }
+                    EclipseActionButton { text: SystemControls.state.muted ? qsTr("Unmute") : qsTr("Mute"); enabled: !SystemControls.busy && SystemControls.state.volume !== null && SystemControls.state.volume !== undefined; onClicked: SystemControls.request("center-mute") }
+                }
+                ComboBox {
+                    Layout.fillWidth: true
+                    model: SystemControls.state.sinks || []; textRole: "name"
+                    enabled: !SystemControls.busy && count > 0
+                    Accessible.name: qsTr("Audio output")
+                    currentIndex: { var list = SystemControls.state.sinks || []; for (var i=0;i<list.length;i++) if (list[i].default) return i; return -1 }
+                    contentItem: Label { text: parent.displayText; textFormat: Text.PlainText; color: VbTokens.text; verticalAlignment: Text.AlignVCenter; elide: Text.ElideRight }
+                    delegate: ItemDelegate { width: parent.width; contentItem: Label { text: modelData.name; textFormat: Text.PlainText; color: VbTokens.text; elide: Text.ElideRight } }
+                    onActivated: SystemControls.request("center-output", model[index].id)
+                }
+                Repeater {
+                    model: [{kind:"screen",label:qsTr("Screen brightness")},{kind:"keyboard",label:qsTr("Keyboard brightness")}]
+                    delegate: ColumnLayout {
+                        Layout.fillWidth: true
+                        property var hardware: (SystemControls.state.brightness || {})[modelData.kind]
+                        Label { text: modelData.label + (hardware ? " • " + hardware.percent + "%" : " • " + qsTr("Unavailable")); color: VbTokens.text }
+                        Slider {
+                            Layout.fillWidth: true; from: modelData.kind === "screen" ? 5 : 0; to: 100; stepSize: 1
+                            value: hardware ? hardware.percent : 0; enabled: !!hardware && !SystemControls.busy
+                            Accessible.name: modelData.label
+                            onMoved: if (!pressed && enabled) SystemControls.request("center-"+modelData.kind, String(Math.round(value)))
+                            onPressedChanged: if (!pressed && enabled) SystemControls.request("center-"+modelData.kind, String(Math.round(value)))
+                        }
+                    }
+                }
+                EclipseActionButton { text: qsTr("Refresh controls"); enabled: !SystemControls.busy; onClicked: SystemControls.request("center-list") }
+                Label { text: qsTr("Host"); color: VbTokens.text; font.bold: true }
+                Label { Layout.fillWidth: true; textFormat: Text.PlainText; wrapMode: Text.Wrap; text: panel.host.url || qsTr("Select a host in the launcher."); color: VbTokens.textDim }
+                RowLayout {
+                    EclipseActionButton { text: qsTr("Host stats"); enabled: !!panel.host.id; iconSource: "qrc:/res/crimson-host.svg"; onClicked: panel.defer("host") }
+                    EclipseActionButton { text: qsTr("Wake host"); enabled: !!panel.host.id && panel.canWake; onClicked: { panel.wakeRequested(); panel.message = qsTr("Wake request sent; the host must support Wake-on-LAN.") } }
+                }
+                EclipseActionButton { text: qsTr("Open host management"); enabled: !!panel.host.url && panel.canManage; onClicked: panel.defer("management") }
+                Label { text: qsTr("Stream profiles"); color: VbTokens.text; font.bold: true }
+                Label { Layout.fillWidth: true; wrapMode: Text.Wrap; text: panel.host.id ? qsTr("Saved for the selected host. Apply before starting a stream.") : qsTr("Global profiles. Apply before starting a stream."); color: VbTokens.textDim }
+                ComboBox { Layout.fillWidth: true; model: panel.savedNames; visible: count > 0; Accessible.name: qsTr("Saved profiles"); onActivated: profileName.text = model[index] }
+                TextField { id: profileName; Layout.fillWidth: true; maximumLength: 48; placeholderText: qsTr("Profile name"); Accessible.name: qsTr("Profile name") }
+                RowLayout {
+                    EclipseActionButton { text: qsTr("Save current"); onClicked: { panel.message = EclipseProfiles.save(panel.host.id || "", profileName.text, {width:StreamingPreferences.width,height:StreamingPreferences.height,fps:StreamingPreferences.fps,bitrateKbps:StreamingPreferences.bitrateKbps}) ? qsTr("Profile saved.") : qsTr("Profile could not be saved."); panel.savedNames = EclipseProfiles.names(panel.host.id || "") } }
+                    EclipseActionButton { text: qsTr("Apply saved"); onClicked: panel.apply(EclipseProfiles.load(panel.host.id || "", profileName.text)) }
+                }
+                RowLayout {
+                    EclipseActionButton { text: qsTr("Desktop preset"); onClicked: panel.apply({width:1280,height:800,fps:60,bitrateKbps:15000}) }
+                    EclipseActionButton { text: qsTr("Low bandwidth"); onClicked: panel.apply({width:1280,height:720,fps:30,bitrateKbps:5000}) }
+                }
+                Label { text: qsTr("Appearance & accessibility"); color: VbTokens.text; font.bold: true }
+                ComboBox {
+                    Layout.fillWidth: true; model: [qsTr("Text 100%"),qsTr("Text 110%"),qsTr("Text 125%")]
+                    Accessible.name: qsTr("Text size")
+                    currentIndex: EclipseProfiles.textScale === 125 ? 2 : EclipseProfiles.textScale === 110 ? 1 : 0
+                    onActivated: EclipseProfiles.textScale = [100,110,125][index]
+                }
+                Switch { text: qsTr("Reduce motion"); checked: EclipseProfiles.reducedMotion; onToggled: EclipseProfiles.reducedMotion = checked }
+                Switch { text: qsTr("Higher contrast"); checked: EclipseProfiles.highContrast; onToggled: EclipseProfiles.highContrast = checked }
+                Label { text: qsTr("Tools & recovery"); color: VbTokens.text; font.bold: true }
+                RowLayout {
+                    EclipseActionButton { text: qsTr("All settings"); iconSource: "qrc:/res/settings.svg"; onClicked: panel.defer("settings") }
+                    EclipseActionButton { text: qsTr("Support report"); enabled: !SystemControls.busy; onClicked: SystemControls.request("center-report") }
+                }
+                Label { Layout.fillWidth: true; wrapMode: Text.Wrap; text: qsTr("Recovery: Ctrl+Alt+F2 opens the diagnostic console. Mac brightness, keyboard-light and volume keys remain available."); color: VbTokens.textDim }
+                RowLayout {
+                    Repeater {
+                        model: [{action:"reboot",label:qsTr("Restart")},{action:"poweroff",label:qsTr("Shut down")}]
+                        delegate: EclipseActionButton { text: modelData.label; iconSource: "qrc:/res/eclipse-power.svg"; enabled: !SystemControls.busy; onClicked: { panel.powerAction = modelData.action; powerDialog.open() } }
+                    }
+                }
+                EclipseActionButton { text: qsTr("About Eclipse"); enabled: !SystemControls.busy; onClicked: panel.defer("about") }
+                Label { Layout.fillWidth: true; textFormat: Text.PlainText; wrapMode: Text.Wrap; text: panel.message || SystemControls.status; color: VbTokens.textDim }
+                BusyIndicator { running: SystemControls.busy; visible: running; Layout.alignment: Qt.AlignHCenter }
+            }
+        }
+    }
+    NavigableDialog {
+        id: powerDialog
+        width: Math.min(440, panel.width - 32)
+        title: panel.powerAction === "reboot" ? qsTr("Restart Moonlight-OS?") : qsTr("Shut down Moonlight-OS?")
+        standardButtons: Dialog.Yes | Dialog.No
+        Material.background: VbTokens.bgElev
+        onAccepted: SystemControls.request("center-"+panel.powerAction,"",true)
+        contentItem: Label { text: qsTr("This ends the current local session."); color: VbTokens.text }
+    }
+}
