+        QScopedPointer<QObject> root(component.create()); QVERIFY2(root, qPrintable(component.errorString()));
+        auto panel = root->findChild<QObject*>("testPanel"); QVERIFY(panel);
+        auto state = root->findChild<QObject*>("testState"); QVERIFY(state);
+        for (int i = 0; i < 16; ++i) {
