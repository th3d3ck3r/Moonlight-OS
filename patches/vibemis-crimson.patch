new file mode 100644
index 00000000..77ec4c82
--- /dev/null
+++ b/app/moonlightos/systemcontrols.cpp
@@ -0,0 +1,83 @@
+#include "systemcontrols.h"
+#include <QCoreApplication>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QJsonArray>
+#include <QQmlEngine>
+#include <QFileInfo>
+SystemControls::SystemControls(QObject* parent) : QObject(parent) {
+    m_timeout.setSingleShot(true);
+    connect(&m_timeout, &QTimer::timeout, this, [this] { fail(tr("Operation timed out. Retry or use the diagnostic shell.")); });
+    connect(&m_process, &QProcess::started, this, [this] { request(m_mode + "-list"); });
+    connect(&m_process, &QProcess::readyReadStandardError, this, [this] { m_process.readAllStandardError(); });
+    connect(&m_process, &QProcess::readyReadStandardOutput, this, [this] {
+        m_buffer += m_process.readAllStandardOutput();
+        if (m_buffer.size() > 65536) { fail(tr("Invalid system response.")); return; }
+        while (m_buffer.contains('\n')) {
+            int end = m_buffer.indexOf('\n');
+            QJsonParseError error;
+            auto document = QJsonDocument::fromJson(m_buffer.left(end), &error);
+            m_buffer.remove(0, end + 1);
+            if (error.error != QJsonParseError::NoError || !document.isObject()) { fail(tr("Invalid system response.")); return; }
+            auto value = document.object();
+            if (value.contains("prompt")) {
+                m_prompt = value.value("prompt").toString().left(1024);
+                m_timeout.start(120000);
+            }
+            if (value.value("done").toBool()) {
+                m_timeout.stop(); m_busy = false; m_prompt.clear();
+                if (value.contains("items")) {
+                    auto entries = value.value("items").toArray();
+                    if (entries.size() > 64) { fail(tr("Invalid device list.")); return; }
+                    m_items = entries.toVariantList();
+                }
+                if (value.value("state").isObject()) m_state = value.value("state").toObject().toVariantMap();
+                m_status = value.contains("error") ? value.value("error").toString().left(1024) : value.value("status").toString();
+            }
+            emit changed();
+        }
+    });
+    connect(&m_process, &QProcess::errorOccurred, this, [this](QProcess::ProcessError) {
+        if (!m_mode.isEmpty()) fail(tr("System controls are unavailable. Use the diagnostic shell."));
+    });
+    connect(&m_process, QOverload<int,QProcess::ExitStatus>::of(&QProcess::finished), this, [this](int, QProcess::ExitStatus) {
+        if (!m_mode.isEmpty()) { m_timeout.stop(); m_busy = false; m_prompt.clear(); m_status = tr("System helper stopped. Close and reopen this panel."); emit changed(); }
+    });
+}
+SystemControls::~SystemControls() { close(); if (!m_process.waitForFinished(500)) { m_process.kill(); m_process.waitForFinished(500); } }
+void SystemControls::send(const QJsonObject& value) { m_process.write(QJsonDocument(value).toJson(QJsonDocument::Compact) + '\n'); }
+void SystemControls::open(QString mode) {
+    if (mode != "wifi" && mode != "bt" && mode != "center") return;
+    close();
+    if (m_process.state() != QProcess::NotRunning) { m_process.kill(); m_process.waitForFinished(500); }
+    m_mode = mode; m_items.clear(); m_state.clear(); m_buffer.clear(); m_status = tr("Loading…"); emit changed();
+    QString helper = "/usr/local/libexec/moonlight-os/system-controls.py";
+#ifdef MOONLIGHT_CONTROLS_TEST
+    helper = qEnvironmentVariable("MOONLIGHT_CONTROLS_FIXTURE", helper);
+#endif
+    m_process.start("python3", {helper});
+}
+void SystemControls::request(QString action, QString id, bool confirm) {
+    if (m_busy || m_process.state() != QProcess::Running || !action.startsWith(m_mode + "-")) return;
+    const QStringList allowed = {"wifi-list", "wifi-scan", "wifi-connect", "wifi-disconnect", "bt-list", "bt-scan", "bt-connect", "bt-disconnect", "bt-forget", "center-list", "center-volume", "center-mute", "center-output", "center-screen", "center-keyboard", "center-reboot", "center-poweroff", "center-suspend", "center-report"};
+    if (!allowed.contains(action)) return;
+    m_busy = true; m_prompt.clear(); m_status = tr("Working…"); m_timeout.start(120000);
+    send({{"action", action}, {"id", id}, {"confirm", confirm}}); emit changed();
+}
+void SystemControls::answer(QString value) {
+    if (!m_busy || m_prompt.isEmpty() || value.size() > 4096 || value.contains('\n') || value.contains('\r') || value.contains(QChar(0))) return;
+    send({{"action", "answer"}, {"value", value}}); m_prompt.clear(); m_timeout.start(120000); emit changed();
+}
+void SystemControls::close() {
+    m_mode.clear(); m_timeout.stop(); m_busy = false; m_prompt.clear(); m_buffer.clear();
+    if (m_process.state() != QProcess::NotRunning) {
+        m_process.terminate();
+        QTimer::singleShot(4000, this, [this] { if (m_mode.isEmpty() && m_process.state() != QProcess::NotRunning) m_process.kill(); });
+    }
+    emit changed();
+}
+void SystemControls::fail(QString message) { close(); m_status = message; emit changed(); }
+static void registerSystemControls() {
+    qmlRegisterSingletonType<SystemControls>("SystemControls", 1, 0, "SystemControls", [](QQmlEngine*, QJSEngine*) -> QObject* { return new SystemControls(); });
+}
+Q_COREAPP_STARTUP_FUNCTION(registerSystemControls)
