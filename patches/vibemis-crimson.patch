@@ -0,0 +1,41 @@
+#include "eclipseprofiles.h"
+#include <QCryptographicHash>
+#include <QCoreApplication>
+#include <QQmlEngine>
+QString EclipseProfiles::key(QString host, QString name) {
+    return "eclipse/profiles/" + QString::fromLatin1(QCryptographicHash::hash(host.toUtf8(), QCryptographicHash::Sha256).toHex()) + "/" + QString::fromLatin1(QCryptographicHash::hash(name.trimmed().toUtf8(), QCryptographicHash::Sha256).toHex());
+}
+bool EclipseProfiles::valid(const QVariantMap& values) {
+    const QMap<QString,QPair<int,int>> ranges = {{"width",{320,7680}}, {"height",{200,4320}}, {"fps",{1,240}}, {"bitrateKbps",{500,150000}}};
+    if (values.size() != ranges.size()) return false;
+    for (auto i = ranges.begin(); i != ranges.end(); ++i) {
+        bool ok; auto n = values.value(i.key()).toInt(&ok);
+        if (!ok || n < i.value().first || n > i.value().second) return false;
+    }
+    return true;
+}
+bool EclipseProfiles::save(QString host, QString name, QVariantMap values) {
+    name = name.trimmed();
+    if (host.size() > 256 || name.isEmpty() || name.size() > 48 || !valid(values)) return false;
+    if (!names(host).contains(name) && names(host).size() >= 32) return false;
+    QSettings settings; settings.setValue(key(host,name)+"/name",name); settings.setValue(key(host,name)+"/values",values); settings.sync();
+    return settings.status() == QSettings::NoError;
+}
+QVariantMap EclipseProfiles::load(QString host, QString name) {
+    QSettings settings; auto value = settings.value(key(host,name)+"/values").toMap();
+    return valid(value) ? value : QVariantMap();
+}
+bool EclipseProfiles::remove(QString host, QString name, bool confirmed) {
+    if (!confirmed) return false;
+    QSettings settings; settings.remove(key(host,name)); settings.sync(); return settings.status() == QSettings::NoError;
+}
+QStringList EclipseProfiles::names(QString host) {
+    QSettings settings; settings.beginGroup(key(host, "").section('/',0,-2));
+    QStringList result;
+    for (const auto& child : settings.childGroups()) { auto name = settings.value(child+"/name").toString(); if (!name.isEmpty()) result.append(name); }
+    result.sort(); return result;
+}
+static void registerEclipseProfiles() {
+    qmlRegisterSingletonType<EclipseProfiles>("EclipseProfiles",1,0,"EclipseProfiles",[](QQmlEngine*,QJSEngine*) -> QObject* { return new EclipseProfiles(); });
+}
+Q_COREAPP_STARTUP_FUNCTION(registerEclipseProfiles)
