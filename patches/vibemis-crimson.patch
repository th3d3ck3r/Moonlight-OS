diff --git a/app/gui/SystemConnectionsDialog.qml b/app/gui/SystemConnectionsDialog.qml
new file mode 100644
index 00000000..cff4c660
--- /dev/null
+++ b/app/gui/SystemConnectionsDialog.qml
@@ -0,0 +1,107 @@
+import QtQuick 2.9
+import QtQuick.Controls 2.5
+import QtQuick.Layouts 1.3
+import QtQuick.Controls.Material 2.2
+import Vibemis.Redesign 1.0
+import SystemControls 1.0
+
+NavigableDialog {
+    id: panel
+    property string kind: "wifi"
+    property var selected: ({})
+    width: Math.min(620, parent.width - 32)
+    height: Math.min(560, parent.height - 32)
+    title: kind === "wifi" ? qsTr("Wi-Fi networks") : qsTr("Bluetooth devices")
+    standardButtons: Dialog.Close
+    Material.background: VbTokens.bgElev
+    Material.accent: VbTokens.accent
+    background: Rectangle { color: VbTokens.bgElev; radius: VbTokens.radiusDialog; border.color: VbTokens.stroke }
+    onOpened: { selected = ({}); SystemControls.open(kind) }
+    onClosed: { credential.close(); secret.text = ""; forget.close(); SystemControls.close() }
+    contentItem: ColumnLayout {
+        spacing: VbTokens.space3
+        RowLayout {
+            Layout.fillWidth: true
+            Label { Layout.fillWidth: true; wrapMode: Text.Wrap; textFormat: Text.PlainText; text: SystemControls.status; color: VbTokens.textDim }
+            BusyIndicator { running: SystemControls.busy; visible: running; implicitWidth: 32; implicitHeight: 32 }
+            EclipseActionButton { id: scanButton; text: qsTr("Scan"); enabled: !SystemControls.busy; onClicked: { panel.selected = ({}); SystemControls.request(panel.kind + "-scan") } }
+        }
+        Label {
+            Layout.fillWidth: true; wrapMode: Text.Wrap; color: VbTokens.textDim
+            text: panel.kind === "wifi" ? qsTr("Select a network, then Connect. Advanced or hidden networks are available in the diagnostic shell.") : qsTr("Put your controller or headphones in pairing mode, then Scan. Pairing may take up to a minute.")
+        }
+        ListView {
+            id: devices
+            Layout.fillWidth: true; Layout.fillHeight: true
+            clip: true; spacing: 4; model: SystemControls.items
+            ScrollBar.vertical: ScrollBar {}
+            delegate: ItemDelegate {
+                width: devices.width
+                enabled: !SystemControls.busy
+                highlighted: panel.selected.id === modelData.id
+                activeFocusOnTab: true
+                Keys.onReturnPressed: if (enabled) clicked()
+                Keys.onEnterPressed: if (enabled) clicked()
+                Keys.onDownPressed: { if (index + 1 < devices.count) { devices.incrementCurrentIndex(); if (devices.currentItem) devices.currentItem.forceActiveFocus(Qt.TabFocus) } else if (connectButton.enabled) connectButton.forceActiveFocus(Qt.TabFocus); else scanButton.forceActiveFocus(Qt.TabFocus) }
+                Keys.onUpPressed: { if (index > 0) { devices.decrementCurrentIndex(); if (devices.currentItem) devices.currentItem.forceActiveFocus(Qt.TabFocus) } else scanButton.forceActiveFocus(Qt.TabFocus) }
+                contentItem: Label {
+                    textFormat: Text.PlainText; elide: Text.ElideRight; color: VbTokens.text
+                    text: modelData.name + " · " + modelData.detail + (modelData.connected ? " · " + qsTr("Connected") : "")
+                }
+                onClicked: { panel.selected = modelData; devices.currentIndex = index }
+            }
+        }
+        RowLayout {
+            Layout.fillWidth: true
+            EclipseActionButton {
+                id: connectButton
+                text: panel.kind === "wifi" ? qsTr("Connect") : qsTr("Pair / Connect")
+                enabled: !!panel.selected.id && !SystemControls.busy
+                onClicked: SystemControls.request(panel.kind + "-connect", panel.selected.id)
+            }
+            EclipseActionButton {
+                text: qsTr("Disconnect"); enabled: !!panel.selected.id && panel.selected.connected && !SystemControls.busy
+                onClicked: SystemControls.request(panel.kind + "-disconnect", panel.selected.id)
+            }
+            EclipseActionButton { text: qsTr("Forget"); visible: panel.kind === "bt"; enabled: !!panel.selected.id && !SystemControls.busy; onClicked: forget.open() }
+        }
+    }
+    Connections {
+        target: SystemControls
+        onChanged: {
+            if (SystemControls.prompt.length > 0 && panel.opened && !credential.opened) credential.open()
+            if (!SystemControls.busy) {
+                credential.close(); secret.text = ""
+                var id = panel.selected.id
+                panel.selected = ({})
+                for (var i = 0; i < SystemControls.items.length; i++)
+                    if (SystemControls.items[i].id === id) panel.selected = SystemControls.items[i]
+            }
+        }
+    }
+    NavigableDialog {
+        id: credential
+        title: qsTr("Connection authentication")
+        width: Math.min(480, panel.width)
+        closePolicy: Popup.NoAutoClose
+        standardButtons: Dialog.Ok | Dialog.Cancel
+        Material.background: VbTokens.bgElev
+        onOpened: { secret.text = ""; secret.forceActiveFocus() }
+        onAccepted: { SystemControls.answer(secret.text); secret.text = "" }
+        onRejected: { secret.text = ""; SystemControls.close() }
+        contentItem: ColumnLayout {
+            Label { Layout.fillWidth: true; textFormat: Text.PlainText; wrapMode: Text.Wrap; text: SystemControls.prompt; color: VbTokens.text }
+            TextField { id: secret; Layout.fillWidth: true; echoMode: TextInput.Password; maximumLength: 4096; selectByMouse: true; onAccepted: credential.accept() }
+            Label { Layout.fillWidth: true; wrapMode: Text.Wrap; text: qsTr("Enter the requested password or PIN. For a yes/no confirmation, type yes or no."); color: VbTokens.textDim }
+        }
+    }
+    NavigableDialog {
+        id: forget
+        title: qsTr("Forget Bluetooth device?")
+        width: Math.min(480, panel.width)
+        standardButtons: Dialog.Yes | Dialog.No
+        Material.background: VbTokens.bgElev
+        onAccepted: SystemControls.request("bt-forget", panel.selected.id, true)
+        contentItem: Label { textFormat: Text.PlainText; wrapMode: Text.Wrap; text: qsTr("Remove the saved pairing for %1? You will need to pair it again.").arg(panel.selected.name || ""); color: VbTokens.text }
+    }
+}
