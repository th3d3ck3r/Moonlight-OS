index c3f3c819..7115c336 100644
--- a/app/res/vibemis.svg
+++ b/app/res/vibemis.svg
@@ -1,19 +1,7 @@
-<?xml version="1.0" encoding="UTF-8" standalone="no"?>
-<!-- Vibemis brand mark: a cut-gem diamond cradling a play triangle.
-     Drawn from the design-kit tokens (docs/design/redesign/logo/README.md):
-     diamond half-diagonal ~37% of the box, stroke ~7.8% of the box, filled
-     play triangle ~30% tall centered inside, accent gradient
-     #6ADDE7 -> #2FC6D0. The soft glow is omitted so the mark stays crisp at
-     the small sizes this SVG is rasterized at (SDL stream-window icon). -->
-<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" width="256" height="256">
-  <defs>
-    <linearGradient id="vbAccent" x1="0" y1="0" x2="1" y2="1">
-      <stop offset="0" stop-color="#6ADDE7"/>
-      <stop offset="1" stop-color="#2FC6D0"/>
-    </linearGradient>
-  </defs>
-  <path d="M 128 33.3 L 222.7 128 L 128 222.7 L 33.3 128 Z" fill="none"
-        stroke="url(#vbAccent)" stroke-width="20" stroke-linejoin="round"/>
-  <path d="M 107 92.6 L 107 163.4 L 168 128 Z" fill="url(#vbAccent)"
-        stroke="url(#vbAccent)" stroke-width="12" stroke-linejoin="round"/>
+<svg xmlns="http://www.w3.org/2000/svg" width="512" height="512" viewBox="0 0 512 512">
+<defs><linearGradient id="rim" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#ff758b"/><stop offset=".48" stop-color="#dc3658"/><stop offset="1" stop-color="#63152b"/></linearGradient><linearGradient id="glass" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#20151c"/><stop offset="1" stop-color="#08080b"/></linearGradient></defs>
+<rect x="12" y="12" width="488" height="488" rx="110" fill="url(#glass)" stroke="#ffffff" stroke-opacity=".13" stroke-width="2"/>
+<circle cx="256" cy="256" r="144" fill="url(#rim)"/>
+<circle cx="268" cy="249" r="136" fill="#08080b"/>
+<path d="M151 162a143 143 0 0 1 135-48" fill="none" stroke="#ffe8ee" stroke-opacity=".55" stroke-width="3" stroke-linecap="round"/>
 </svg>
