+class TlsFixture : public QTcpServer {
+public:
+    QByteArray body = R"({"cpu_percent":37.5,"ram_used_bytes":50,"ram_total_bytes":100})";
+    int code = 200, requests = 0;
+    bool respond = true;
+    QByteArray authorization;
+    QSslCertificate cert;
+    QSslKey key;
+    TlsFixture() {
+        QFile c(qEnvironmentVariable("CRIMSON_TEST_CERT")); c.open(QIODevice::ReadOnly); cert = QSslCertificate(c.readAll());
+        QFile k(qEnvironmentVariable("CRIMSON_TEST_KEY")); k.open(QIODevice::ReadOnly); key = QSslKey(k.readAll(), QSsl::Rsa);
+        listen(QHostAddress::LocalHost);
+    }
+    void incomingConnection(qintptr descriptor) override {
+        auto socket = new QSslSocket(this);
+        socket->setLocalCertificate(cert); socket->setPrivateKey(key); socket->setPeerVerifyMode(QSslSocket::VerifyNone);
+        socket->setSocketDescriptor(descriptor);
+        auto input = std::make_shared<QByteArray>();
+        connect(socket, &QSslSocket::readyRead, this, [this, socket, input] {
+            input->append(socket->readAll());
+            if (!input->contains("\r\n\r\n")) return;
+            ++requests; authorization = *input;
+            if (respond) {
+                QByteArray header = "HTTP/1.1 " + QByteArray::number(code) + " Fixture\r\nContent-Type: application/json\r\nConnection: close\r\nContent-Length: " + QByteArray::number(body.size()) + "\r\n";
+                if (code == 302) header += "Location: https://127.0.0.2:12345/\r\n";
+                socket->write(header + "\r\n" + body); socket->disconnectFromHost();
+            }
+            input->clear();
+        });
+        connect(socket, &QSslSocket::disconnected, socket, &QObject::deleteLater);
+        socket->startServerEncryption();
+    }
+};
+
+class CrimsonTest : public QObject {
+    Q_OBJECT
+private slots:
+    void initTestCase() {
+        QCoreApplication::setOrganizationName("Moonlight-OS Test");
+        QCoreApplication::setApplicationName("EclipseFixture");
+        QSettings::setDefaultFormat(QSettings::IniFormat);
+    }
+    void hostProfilesRemainIsolated() {
+        EclipseProfiles profiles;
+        QVariantMap values{{"width",1280},{"height",800},{"fps",60},{"bitrateKbps",15000}};
+        QVERIFY(profiles.save("fixture-host-a","Desktop",values));
+        QCOMPARE(profiles.load("fixture-host-a","Desktop"),values);
+        QVERIFY(profiles.load("fixture-host-b","Desktop").isEmpty());
+        QVERIFY(profiles.names("fixture-host-a").contains("Desktop"));
+        QVERIFY(!profiles.remove("fixture-host-a","Desktop",false));
+        values["fps"] = 0; QVERIFY(!profiles.save("fixture-host-a","Bad",values));
+        QVERIFY(profiles.remove("fixture-host-a","Desktop",true));
+        QVERIFY(profiles.load("fixture-host-a","Desktop").isEmpty());
+    }
+    void systemControlsPrivatePipe() {
+        QTemporaryDir dir; QVERIFY(dir.isValid());
+        QFile script(dir.filePath("fixture.py")); QVERIFY(script.open(QIODevice::WriteOnly));
+        script.write(R"PY(import json,sys
+for line in sys.stdin:
+    value=json.loads(line)
+    action=value['action']
+    if action=='wifi-connect':
+        print(json.dumps({'prompt':'Wi-Fi password'}),flush=True)
+        reply=json.loads(sys.stdin.readline())
+        assert reply=={'action':'answer','value':'secret-value'}
+    print(json.dumps({'items':[{'id':'wlan0/AA:BB:CC:DD:EE:FF','name':'<b>Plain SSID</b>','detail':'80% WPA2','connected':action=='wifi-connect'}],'status':'Ready','done':True}),flush=True)
+)PY"); script.close();
+        qputenv("MOONLIGHT_CONTROLS_FIXTURE", script.fileName().toUtf8());
+        SystemControls controls; controls.open("wifi");
+        QTRY_COMPARE(controls.items().size(), 1); QVERIFY(!controls.busy());
+        controls.request("bt-forget", "invalid", true); QVERIFY(!controls.busy());
+        controls.request("wifi-connect", "wlan0/AA:BB:CC:DD:EE:FF");
+        QTRY_VERIFY(!controls.prompt().isEmpty()); QVERIFY(controls.busy());
+        controls.answer("secret-value"); QTRY_VERIFY(!controls.busy());
+        QVERIFY(controls.prompt().isEmpty()); QCOMPARE(controls.status(), QString("Ready"));
+        QVERIFY(controls.items().first().toMap().value("connected").toBool());
+        controls.close(); QVERIFY(!controls.busy());
+        qunsetenv("MOONLIGHT_CONTROLS_FIXTURE");
+    }
+    void managedUpdaterCannotReplaceCustomizedClient() {
+        QTemporaryDir dir; QVERIFY(dir.isValid());
+        const QString image = dir.filePath("custom.AppImage");
+        QFile f(image); QVERIFY(f.open(QIODevice::WriteOnly)); f.write("customized client"); f.close();
+        const QByteArray old = qgetenv("APPIMAGE"); const bool had = qEnvironmentVariableIsSet("APPIMAGE");
+        qputenv("APPIMAGE", image.toUtf8());
+        AutoUpdateChecker checker;
+        QVERIFY(checker.osManaged()); QVERIFY(!checker.canInstallUpdates());
+        QSignalSpy completed(&checker, &AutoUpdateChecker::checkCompleted);
+        QSignalSpy failed(&checker, &AutoUpdateChecker::installFailed);
+        checker.start(); checker.checkNow(); checker.channelChanged(); checker.install();
+        QCOMPARE(completed.count(), 3); QCOMPARE(failed.count(), 1);
+        QVERIFY(!checker.checking()); QVERIFY(!checker.installing());
+        QVERIFY(!checker.canInstall()); QVERIFY(!checker.updateAvailable()); QVERIFY(!checker.offerAvailable());
+        QCOMPARE(checker.releaseUrl(), QString("https://github.com/th3d3ck3r/Moonlight-OS/releases"));
+        QVERIFY(checker.currentVersion().contains("Moonlight-OS customized"));
+        QVERIFY(f.open(QIODevice::ReadOnly)); QCOMPARE(f.readAll(), QByteArray("customized client")); f.close();
+        QCOMPARE(QDir(dir.path()).entryList(QDir::Files), QStringList{"custom.AppImage"});
+        if (had) qputenv("APPIMAGE", old); else qunsetenv("APPIMAGE");
+        QCOMPARE(AutoUpdateChecker::compareSemanticVersions("0.5.0", "0.4.9"), 1);
+    }
+    void endpointValidation() {
+        QVERIFY(CrimsonStatus::validEndpoint("https://192.168.1.10:47990"));
+        QVERIFY(CrimsonStatus::validEndpoint("https://[fd00::1]:47990/"));
+        for (auto bad : {"http://host", "https://user:secret@host", "https://host/api", "https://host/?token=secret", "file:///etc/passwd", "https://host/#fragment"})
+            QVERIFY(!CrimsonStatus::validEndpoint(bad));
+    }
+    void missingAndInvalidMetrics() {
+        QString error;
+        QVERIFY(CrimsonStatus::parseStats("not json", &error).isEmpty()); QVERIFY(!error.isEmpty());
+        auto s = CrimsonStatus::parseStats(R"({"cpu_percent":42.5,"cpu_temp_c":-1,"gpu_percent":null,"ram_total_bytes":0,"ram_percent":0,"vram_total_bytes":100,"vram_used_bytes":120})", &error);
+        QVERIFY(error.isEmpty()); QCOMPARE(s.value("cpu_percent").toDouble(), 42.5);
+        QVERIFY(!s.contains("cpu_temp_c")); QVERIFY(!s.contains("gpu_percent")); QVERIFY(!s.contains("ram_percent"));
+        QCOMPARE(s.value("vram_percent").toDouble(), 100.0);
+        auto invalid = CrimsonStatus::parseStats(R"({"cpu_percent":101,"gpu_percent":"0"})", &error);
+        QVERIFY(invalid.isEmpty()); QVERIFY(error.isEmpty());
+        CrimsonStatus::parseStats(QByteArray(65537, 'a'), &error); QVERIFY(!error.isEmpty());
+        CrimsonStatus::parseStats(R"({"error":"unsupported"})", &error); QVERIFY(!error.isEmpty());
+    }
+    void localHardwareFixture() {
+        QTemporaryDir temp; QVERIFY(temp.isValid());
+        auto write = [&](QString p, QByteArray value) { QDir().mkpath(QFileInfo(temp.path()+p).absolutePath()); QFile f(temp.path()+p); QVERIFY(f.open(QIODevice::WriteOnly)); f.write(value); };
+        write("/class/power_supply/BAT0/type", "Battery"); write("/class/power_supply/BAT0/capacity", "73"); write("/class/power_supply/BAT0/status", "Charging");
+        write("/class/net/wlan0/operstate", "up"); write("/class/net/lo/operstate", "up");
+        auto local = CrimsonStatus::readLocal(temp.path()); QCOMPARE(local.value("batteryPercent").toInt(), 73); QCOMPARE(local.value("batteryState").toString(), QString("Charging"));
+        QCOMPARE(local.value("network").toString(), QString("wlan0")); QVERIFY(local.value("connected").toBool());
+        write("/class/power_supply/BAT0/capacity", "101"); QCOMPARE(CrimsonStatus::readLocal(temp.path()).value("batteryPercent").toInt(), -1);
+    }
+    void privateSettingsAndNoCrossHostCredentials() {
+        QStandardPaths::setTestModeEnabled(true);
+        CrimsonStatus status; status.selectHost("test-a", "https://127.0.0.1:47990");
+        QVERIFY(status.configure("https://127.0.0.1:47990", "fixture-token", "")); QVERIFY(status.configured());
+        auto path = QStandardPaths::writableLocation(QStandardPaths::AppConfigLocation) + "/crimson-hosts.json";
+        QVERIFY((QFile::permissions(path) & (QFileDevice::ReadGroup | QFileDevice::ReadOther | QFileDevice::WriteGroup | QFileDevice::WriteOther)) == 0);
+        status.selectHost("test-b", "https://127.0.0.2:47990"); QVERIFY(!status.configured());
+        QVERIFY(!status.configure("https://127.0.0.2:47990", "", ""));
+        QVERIFY(!status.configure("https://127.0.0.2:47990", "fixture-token", "invalid-pin"));
+        QVERIFY(!status.configure("https://127.0.0.2:47990", "token\ninjection", ""));
+        QFile::remove(path);
+    }
+    void tlsAuthenticationAndVisibility() {
+        TlsFixture server; QVERIFY(server.isListening()); QVERIFY(!server.cert.isNull());
+        QString url = "https://127.0.0.1:" + QString::number(server.serverPort());
+        QString pin = QString::fromLatin1(server.cert.digest(QCryptographicHash::Sha256).toHex());
+        CrimsonStatus status; status.selectHost("fixture-tls", url);
+        QVERIFY(status.configure(url, "fixture-only-token", "")); status.setVisible(true);
+        QTRY_VERIFY_WITH_TIMEOUT(status.status().contains("fingerprint"), 5000);
+        QCOMPARE(server.requests, 0); // no credentials sent before trusting self-signed TLS
+        QVERIFY(status.configure(url, "fixture-only-token", pin));
+        QTRY_COMPARE_WITH_TIMEOUT(status.stats().value("cpu_percent").toDouble(), 37.5, 5000);
+        QVERIFY(server.authorization.contains("Authorization: Bearer fixture-only-token"));
+        QVERIFY(server.authorization.startsWith("GET /api/host/stats "));
+        status.setVisible(false); int count = server.requests; QTest::qWait(2100); QCOMPARE(server.requests, count);
+        for (int code : {401, 403, 404, 302}) {
+            server.code = code; int prior = server.requests; status.setVisible(true);
+            QTRY_VERIFY_WITH_TIMEOUT(server.requests > prior, 5000);
+            QTRY_VERIFY_WITH_TIMEOUT(status.stats().isEmpty(), 5000);
+            status.setVisible(false);
+        }
+        server.code = 200; server.body = QByteArray(70000, 'a'); int prior = server.requests; status.setVisible(true);
+        QTRY_VERIFY_WITH_TIMEOUT(server.requests > prior, 5000);
+        QTRY_VERIFY_WITH_TIMEOUT(status.stats().isEmpty(), 5000); status.setVisible(false);
+        QVERIFY(status.configure(url, "fixture-only-token", QString(64, '0'))); status.setVisible(true);
+        count = server.requests; QTest::qWait(500); QCOMPARE(server.requests, count); QVERIFY(status.stats().isEmpty());
+        status.setVisible(false);
+    }
+    void iconResources() {
+        for (const QString& name : {"eclipse-icon", "eclipse-controls", "eclipse-power", "crimson-network", "crimson-bluetooth", "crimson-battery", "crimson-host", "settings"}) {
+            const QString path = ":/res/" + name + ".svg";
+            QVERIFY2(QFile::exists(path), qPrintable(path));
+            QImageReader reader(path);
+            QVERIFY2(!reader.read().isNull(), qPrintable(path + ": " + reader.errorString()));
+        }
+    }
+    void qmlPaletteAndPanels() {
+        QString source = qEnvironmentVariable("VIBEMIS_TEST_SOURCE"); QVERIFY(!source.isEmpty());
+        QQuickStyle::setStyle("Material");
+        qmlRegisterSingletonType(QUrl::fromLocalFile(source + "/app/moonlightos/tests/Preferences.qml"), "StreamingPreferences", 1, 0, "StreamingPreferences");
+        qmlRegisterSingletonType(QUrl::fromLocalFile(source + "/app/gui/VbTokens.qml"), "Vibemis.Redesign", 1, 0, "VbTokens");
+        QTemporaryDir controlsFixture; QVERIFY(controlsFixture.isValid());
+        QFile helper(controlsFixture.filePath("helper.py")); QVERIFY(helper.open(QIODevice::WriteOnly));
+        helper.write(R"PY(import json,sys
+for line in sys.stdin:
+    value=json.loads(line)
+    print(json.dumps({'state':{'volume':50,'muted':False,'sinks':[{'id':'42','name':'Speakers','default':True},{'id':'57','name':'AirPods','default':False}],'brightness':{'screen':{'device':'intel_backlight','percent':60},'keyboard':{'device':'spi::kbd_backlight','percent':30}},'os':{'NAME':'Moonlight-OS','VERSION':'0.3-dev','TARGET':'Fixture hardware','FEDORA':'44'},'kernel':'fixture-kernel'},'items':[{'id':'fixture','name':'Fixture device','detail':'Available','connected':True}],'status':'Ready','done':True}),flush=True)
+)PY"); helper.close();
+        qputenv("MOONLIGHT_CONTROLS_FIXTURE",helper.fileName().toUtf8());
+        QQmlEngine engine;
+        QQmlComponent component(&engine, QUrl::fromLocalFile(source + "/app/moonlightos/tests/Harness.qml"));
+        QScopedPointer<QObject> root(component.create()); QVERIFY2(root, qPrintable(component.errorString()));
+        auto panel = root->findChild<QObject*>("testPanel"); QVERIFY(panel);
+        auto state = root->findChild<QObject*>("testState"); QVERIFY(state);
+        for (int i = 0; i < 16; ++i) {
+            QVERIFY(QMetaObject::invokeMethod(root.data(), "chooseAccent", Q_ARG(QVariant, i)));
+            QVERIFY(state->property("accent").value<QColor>().isValid());
+            QVERIFY(state->property("pressed").value<QColor>().isValid());
+        }
+        QVERIFY(QMetaObject::invokeMethod(root.data(), "chooseAccent", Q_ARG(QVariant, 4)));
+        for (QString kind : {"network", "battery", "host"}) {
+            QVERIFY(panel->setProperty("kind", kind));
+            QVERIFY(QMetaObject::invokeMethod(panel, "open")); QTest::qWait(300);
+            QVERIFY(panel->property("visible").toBool());
+            QString out = qEnvironmentVariable("CRIMSON_SCREENSHOTS");
+            if (!out.isEmpty()) {
+                QDir().mkpath(out);
+                auto window = qobject_cast<QQuickWindow*>(root.data()); QVERIFY(window);
+                QVERIFY(window->grabWindow().save(out + "/" + kind + ".png"));
+            }
+            QVERIFY(QMetaObject::invokeMethod(panel, "close")); QTest::qWait(300);
+        }
+        auto connections = root->findChild<QObject*>("connectionsPanel"); QVERIFY(connections);
+        for (QString kind : {"wifi", "bt"}) {
+            root->setProperty("width", 1024); root->setProperty("height", 640);
+            QVERIFY(connections->setProperty("kind", kind));
+            QVERIFY(QMetaObject::invokeMethod(connections, "open")); QTest::qWait(300);
+            QVERIFY(connections->property("visible").toBool());
+            QVERIFY(connections->property("width").toInt() <= 992);
+            QString out = qEnvironmentVariable("CRIMSON_SCREENSHOTS");
+            if (!out.isEmpty()) {
+                auto window = qobject_cast<QQuickWindow*>(root.data()); QVERIFY(window);
+                QVERIFY(window->grabWindow().save(out + "/" + kind + "-selector.png"));
+            }
+            QVERIFY(QMetaObject::invokeMethod(connections, "close")); QTest::qWait(300);
+        }
+        QQmlComponent actionComponent(&engine,QUrl::fromLocalFile(source+"/app/gui/EclipseActionButton.qml"));
+        QScopedPointer<QObject> action(actionComponent.create()); QVERIFY2(action,qPrintable(actionComponent.errorString()));
+        auto actionItem = qobject_cast<QQuickItem*>(action.data()); QVERIFY(actionItem);
+        auto actionWindow = qobject_cast<QQuickWindow*>(root.data()); QVERIFY(actionWindow);
+        actionItem->setParentItem(actionWindow->contentItem()); actionItem->forceActiveFocus();
+        QSignalSpy activated(action.data(),SIGNAL(clicked()));
+        QTest::keyClick(actionWindow,Qt::Key_Return); QCOMPARE(activated.count(),1);
+        actionItem->setVisible(false);
+        auto center = root->findChild<QObject*>("controlCenter"); QVERIFY(center);
+        QVERIFY(QMetaObject::invokeMethod(center,"open")); QTest::qWait(500);
+        QVERIFY(center->property("visible").toBool());
+        QString out = qEnvironmentVariable("CRIMSON_SCREENSHOTS");
+        auto window = qobject_cast<QQuickWindow*>(root.data()); QVERIFY(window);
+        if (!out.isEmpty()) QVERIFY(window->grabWindow().save(out+"/eclipse-control-center.png"));
+        QVERIFY(QMetaObject::invokeMethod(center,"close")); QTest::qWait(300);
+        auto about = root->findChild<QObject*>("aboutEclipse"); QVERIFY(about);
+        about->setProperty("info", QVariantMap{{"os",QVariantMap{{"NAME","Moonlight-OS"},{"VERSION","0.3-dev"},{"TARGET","Fixture hardware"},{"FEDORA","44"}}},{"kernel","fixture-kernel"}});
+        QVERIFY(QMetaObject::invokeMethod(about,"open")); QTest::qWait(300);
+        QVERIFY(about->property("visible").toBool());
+        if (!out.isEmpty()) QVERIFY(window->grabWindow().save(out+"/eclipse-about.png"));
+        QVERIFY(QMetaObject::invokeMethod(about,"close"));
+        qunsetenv("MOONLIGHT_CONTROLS_FIXTURE");
+    }
+};
+QTEST_MAIN(CrimsonTest)
