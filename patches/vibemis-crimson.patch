diff --git a/app/gui/CrimsonStatusDialog.qml b/app/gui/CrimsonStatusDialog.qml
new file mode 100644
index 00000000..6870f9c3
--- /dev/null
+++ b/app/gui/CrimsonStatusDialog.qml
@@ -0,0 +1,90 @@
+import QtQuick 2.9
+import QtQuick.Controls 2.5
+import QtQuick.Layouts 1.3
+import QtQuick.Controls.Material 2.2
+import Vibemis.Redesign 1.0
+import CrimsonStatus 1.0
+
+NavigableDialog {
+    id: panel
+    property string kind: "host"
+    width: Math.min(620, parent.width - 32)
+    height: Math.min(kind === "host" ? 650 : 280, parent.height - 32)
+    title: kind === "host" ? qsTr("Vibepollo • Host hardware") : kind === "network" ? qsTr("Network status") : qsTr("Battery status")
+    standardButtons: Dialog.Close
+    Material.background: VbTokens.bgElev
+    Material.accent: VbTokens.accent
+    background: Rectangle { color: VbTokens.bgElev; radius: VbTokens.radiusDialog; border.color: VbTokens.stroke; border.width: 1 }
+    onOpened: {
+        urlInput.text = CrimsonStatus.endpoint
+        pinInput.text = CrimsonStatus.fingerprint
+        tokenInput.text = ""
+        CrimsonStatus.setVisible(kind === "host")
+    }
+    onClosed: { CrimsonStatus.setVisible(false); tokenInput.text = ""; stackView.forceActiveFocus() }
+    function metric(key, suffix) {
+        var n = CrimsonStatus.stats[key]
+        return n === undefined ? qsTr("N/A") : Number(n).toFixed(1) + suffix
+    }
+    function memory(prefix) {
+        var s = CrimsonStatus.stats
+        return s[prefix + "_used_bytes"] === undefined || !s[prefix + "_total_bytes"] ? qsTr("N/A")
+             : (s[prefix + "_used_bytes"] / 1073741824).toFixed(1) + " / " + (s[prefix + "_total_bytes"] / 1073741824).toFixed(1) + " GiB"
+    }
+    contentItem: ScrollView {
+        clip: true
+        contentWidth: availableWidth
+        ColumnLayout {
+            width: panel.availableWidth
+            spacing: VbTokens.space3
+            Label {
+                visible: panel.kind !== "host"
+                Layout.fillWidth: true; wrapMode: Text.Wrap
+                text: panel.kind === "network" ? (CrimsonStatus.local.network + (CrimsonStatus.local.wifiSignal >= 0 ? " • " + CrimsonStatus.local.wifiSignal + "% signal" : "") + "\n" + qsTr("Active link status; internet access is not assumed."))
+                    : (CrimsonStatus.local.batteryPercent >= 0 ? CrimsonStatus.local.batteryPercent + "% • " : "") + CrimsonStatus.local.batteryState
+                color: VbTokens.text; font.pixelSize: VbTokens.typeBody
+            }
+            Label {
+                visible: panel.kind === "host"
+                Layout.fillWidth: true; wrapMode: Text.Wrap
+                text: CrimsonStatus.status
+                color: VbTokens.textDim
+            }
+            Repeater {
+                model: panel.kind === "host" ? [
+                    [qsTr("CPU"), panel.metric("cpu_percent", "%"), panel.metric("cpu_temp_c", " °C")],
+                    [qsTr("RAM"), panel.memory("ram"), panel.metric("ram_percent", "%")],
+                    [qsTr("GPU"), panel.metric("gpu_percent", "%"), panel.metric("gpu_temp_c", " °C")],
+                    [qsTr("VRAM"), panel.memory("vram"), panel.metric("vram_percent", "%")],
+                    [qsTr("GPU encoder"), panel.metric("gpu_encoder_percent", "%"), ""],
+                    [qsTr("Host network"), panel.metric("net_rx_bps", " B/s RX"), panel.metric("net_tx_bps", " B/s TX")]
+                ] : []
+                delegate: Rectangle {
+                    Layout.fillWidth: true; implicitHeight: 58
+                    color: VbTokens.bgWindow; radius: VbTokens.radiusControl
+                    border.color: VbTokens.stroke; border.width: 1
+                    RowLayout {
+                        anchors.fill: parent; anchors.margins: 12
+                        Label { text: modelData[0]; color: VbTokens.textDim; Layout.preferredWidth: 115 }
+                        Label { text: modelData[1]; color: VbTokens.text; Layout.fillWidth: true }
+                        Label { text: modelData[2]; color: VbTokens.accent }
+                    }
+                }
+            }
+            GroupBox {
+                visible: panel.kind === "host"
+                title: qsTr("Configure host stats")
+                Layout.fillWidth: true
+                ColumnLayout {
+                    anchors.fill: parent
+                    Label { Layout.fillWidth: true; wrapMode: Text.Wrap; text: qsTr("Select a host first. Enable realtime stats in Vibepollo and create a read-only token for GET /api/host/stats. GameStream pairing does not grant this access."); color: VbTokens.textDim }
+                    TextField { id: urlInput; Layout.fillWidth: true; placeholderText: qsTr("HTTPS host URL, e.g. https://192.168.1.10:47990"); selectByMouse: true }
+                    TextField { id: tokenInput; Layout.fillWidth: true; placeholderText: qsTr("Read-only API token (blank keeps saved token)"); echoMode: TextInput.Password; selectByMouse: true }
+                    TextField { id: pinInput; Layout.fillWidth: true; placeholderText: qsTr("SHA-256 certificate fingerprint for a self-signed host"); selectByMouse: true }
+                    Label { Layout.fillWidth: true; wrapMode: Text.Wrap; text: qsTr("Verify a self-signed certificate's SHA-256 fingerprint on the host before saving it. Token is stored privately on this USB; it is not encrypted. Unsupported or missing sensors show N/A."); color: VbTokens.textDim }
+                    Button { text: qsTr("Save & connect"); onClicked: { if (CrimsonStatus.configure(urlInput.text, tokenInput.text, pinInput.text)) tokenInput.text = "" } }
+                }
+            }
+        }
+    }
+}
