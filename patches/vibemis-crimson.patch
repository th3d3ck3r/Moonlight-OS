+#pragma once
+#include <QObject>
+#include <QJsonObject>
+#include <QProcess>
+#include <QTimer>
+#include <QVariantList>
+#include <QVariantMap>
+class SystemControls : public QObject {
+    Q_OBJECT
+    Q_PROPERTY(QVariantMap state READ state NOTIFY changed)
+    Q_PROPERTY(QVariantList items READ items NOTIFY changed)
+    Q_PROPERTY(QString status READ status NOTIFY changed)
+    Q_PROPERTY(QString prompt READ prompt NOTIFY changed)
+    Q_PROPERTY(bool busy READ busy NOTIFY changed)
+public:
+    explicit SystemControls(QObject* parent = nullptr);
+    ~SystemControls();
+    QVariantMap state() const { return m_state; }
+    QVariantList items() const { return m_items; }
+    QString status() const { return m_status; }
+    QString prompt() const { return m_prompt; }
+    bool busy() const { return m_busy; }
+    Q_INVOKABLE void open(QString mode);
+    Q_INVOKABLE void request(QString action, QString id = QString(), bool confirm = false);
+    Q_INVOKABLE void answer(QString value);
+    Q_INVOKABLE void close();
+signals:
+    void changed();
+private:
+    void send(const QJsonObject& value);
+    void fail(QString message);
+    QProcess m_process;
+    QTimer m_timeout;
+    QByteArray m_buffer;
+    QVariantList m_items;
+    QVariantMap m_state;
+    QString m_mode, m_status, m_prompt;
+    bool m_busy = false;
+};
