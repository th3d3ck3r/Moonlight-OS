+#pragma once
+#include <QObject>
+#include <QVariantMap>
+#include <QTimer>
+#include <QNetworkAccessManager>
+#include <QPointer>
+#include <QNetworkReply>
+#include <QProcess>
+
+// Optional launcher status. Never participates in the streaming/decoder path.
+class CrimsonStatus : public QObject {
+    Q_OBJECT
+    Q_PROPERTY(QVariantMap local READ local NOTIFY localChanged)
+    Q_PROPERTY(QVariantMap stats READ stats NOTIFY statsChanged)
+    Q_PROPERTY(QString status READ status NOTIFY statsChanged)
+    Q_PROPERTY(QString endpoint READ endpoint NOTIFY configChanged)
+    Q_PROPERTY(QString fingerprint READ fingerprint NOTIFY configChanged)
+    Q_PROPERTY(bool configured READ configured NOTIFY configChanged)
+public:
+    explicit CrimsonStatus(QObject* parent = nullptr);
+    ~CrimsonStatus() override;
+    QVariantMap local() const { return m_local; }
+    QVariantMap stats() const { return m_stats; }
+    QString status() const { return m_status; }
+    QString endpoint() const { return m_endpoint; }
+    QString fingerprint() const { return m_pin; }
+    bool configured() const { return !m_endpoint.isEmpty() && !m_token.isEmpty(); }
+    Q_INVOKABLE void selectHost(QString id, QString suggestedUrl);
+    Q_INVOKABLE bool configure(QString url, QString token, QString pin);
+    Q_INVOKABLE void setVisible(bool visible);
+    Q_INVOKABLE void refresh();
+    static QVariantMap parseStats(const QByteArray& bytes, QString* error);
+    static bool validEndpoint(const QString& url);
+    static QString normalizedPin(QString pin);
+    static QVariantMap readLocal(const QString& sysRoot = "/sys");
+signals:
+    void localChanged();
+    void statsChanged();
+    void configChanged();
+private:
+    void refreshLocal();
+    void fail(QString message);
+    void cancel();
+    QString configFile() const;
+    QString m_host, m_endpoint, m_token, m_pin, m_status = "Choose a host to view hardware stats";
+    QVariantMap m_local, m_stats;
+    QTimer m_localTimer, m_statsTimer;
+    QProcess m_wifi;
+    QNetworkAccessManager m_network;
+    QPointer<QNetworkReply> m_reply;
+    bool m_visible = false;
+};
