+
+QVariantMap ComputerModel::crimsonHost(int index) const
+{
+    if (index < 0 || index >= m_Computers.count()) return {};
+    auto computer = m_Computers[index];
+    QReadLocker lock(&computer->lock);
+    QUrl url; url.setScheme("https"); url.setHost(computer->activeAddress.address());
+    url.setPort(computer->activeAddress.port() > 0 ? computer->activeAddress.port() + 1 : 47990);
+    return {{"id", computer->uuid}, {"url", url.toString()}};
+}
