new file mode 100644
index 00000000..dafca2ee
--- /dev/null
+++ b/app/moonlightos/crimsonstatus.cpp
@@ -0,0 +1,222 @@
+#include "crimsonstatus.h"
+#include <QDateTime>
+#include <QDir>
+#include <QFile>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QNetworkInterface>
+#include <QNetworkRequest>
+#include <QSaveFile>
+#include <QSslCertificate>
+#include <QSslError>
+#include <QStandardPaths>
+#include <QCryptographicHash>
+#include <QUrl>
+#include <cmath>
+#include <QQmlEngine>
+#include <QCoreApplication>
+#include <memory>
+#include <QRegularExpression>
+#include <QFileInfo>
+#include <QSslConfiguration>
+
+namespace {
+QString read(const QString& path) {
+    QFile f(path); return f.open(QIODevice::ReadOnly) ? QString::fromUtf8(f.readAll()).trimmed() : QString();
+}
+const auto userOnly = QFileDevice::ReadOwner | QFileDevice::WriteOwner;
+}
+CrimsonStatus::CrimsonStatus(QObject* parent) : QObject(parent) {
+    connect(&m_localTimer, &QTimer::timeout, this, &CrimsonStatus::refreshLocal);
+    connect(&m_statsTimer, &QTimer::timeout, this, &CrimsonStatus::refresh);
+    connect(&m_wifi, &QProcess::finished, this, [this](int exit, QProcess::ExitStatus) {
+        if (exit == 0) {
+            const auto lines = QString::fromUtf8(m_wifi.readAllStandardOutput()).split('\n');
+            for (const auto& line : lines) {
+                if (!line.startsWith("yes:")) continue;
+                int separator = line.indexOf(':', 4); bool ok = false;
+                int signal = line.mid(4, separator - 4).toInt(&ok);
+                if (ok && signal >= 0 && signal <= 100) m_local["wifiSignal"] = signal;
+                if (separator >= 0) m_local["network"] = tr("Wi-Fi: %1").arg(line.mid(separator + 1));
+                break;
+            }
+            emit localChanged();
+        }
+    });
+    m_localTimer.start(10000); m_statsTimer.setInterval(2000); refreshLocal();
+}
+CrimsonStatus::~CrimsonStatus() {
+    m_statsTimer.stop(); m_localTimer.stop(); cancel();
+    if (m_wifi.state() != QProcess::NotRunning) { m_wifi.kill(); m_wifi.waitForFinished(500); }
+}
+QString CrimsonStatus::configFile() const {
+    return QStandardPaths::writableLocation(QStandardPaths::AppConfigLocation) + "/crimson-hosts.json";
+}
+QString CrimsonStatus::normalizedPin(QString pin) {
+    pin.remove(':'); pin.remove(' '); return pin.toLower();
+}
+bool CrimsonStatus::validEndpoint(const QString& value) {
+    QUrl u(value, QUrl::StrictMode);
+    return u.isValid() && u.scheme() == "https" && !u.host().isEmpty() &&
+        u.userInfo().isEmpty() && u.query().isEmpty() && u.fragment().isEmpty() &&
+        (u.path().isEmpty() || u.path() == "/") && u.port(47990) > 0;
+}
+void CrimsonStatus::cancel() {
+    if (m_reply) { disconnect(m_reply, nullptr, this, nullptr); m_reply->abort(); m_reply->deleteLater(); m_reply = nullptr; }
+}
+void CrimsonStatus::selectHost(QString id, QString suggestedUrl) {
+    if (id == m_host) return;
+    cancel(); m_network.clearConnectionCache(); m_host = id; m_token.clear(); m_pin.clear();
+    m_endpoint = validEndpoint(suggestedUrl) ? suggestedUrl : QString();
+    QFile f(configFile());
+    if (f.open(QIODevice::ReadOnly)) {
+        auto c = QJsonDocument::fromJson(f.readAll()).object().value(id).toObject();
+        if (validEndpoint(c.value("url").toString())) {
+            m_endpoint = c.value("url").toString(); m_token = c.value("token").toString(); m_pin = c.value("pin").toString();
+        }
+    }
+    m_stats.clear(); m_status = id.isEmpty() ? tr("Choose a host to view hardware stats") : tr("Configure a Vibepollo read-only stats token");
+    emit configChanged(); emit statsChanged(); if (m_visible) refresh();
+}
+bool CrimsonStatus::configure(QString url, QString token, QString pin) {
+    pin = normalizedPin(pin);
+    if (m_host.isEmpty() || !validEndpoint(url) || (!pin.isEmpty() &&
+        (pin.size() != 64 || pin.contains(QRegularExpression("[^0-9a-f]"))))) {
+        fail(tr("Use an HTTPS host URL and an optional 64-digit SHA-256 certificate fingerprint")); return false;
+    }
+    // A blank token keeps the old token only for the same endpoint.
+    if (token.isEmpty() && QUrl(url) == QUrl(m_endpoint)) token = m_token;
+    if (token.isEmpty() || token.contains('\r') || token.contains('\n') || token.size() > 4096) {
+        fail(tr("A read-only Vibepollo API token is required")); return false;
+    }
+    QFile f(configFile()); QJsonObject all;
+    if (f.open(QIODevice::ReadOnly)) all = QJsonDocument::fromJson(f.readAll()).object();
+    all[m_host] = QJsonObject{{"url", url}, {"token", token}, {"pin", pin}};
+    QDir().mkpath(QFileInfo(configFile()).absolutePath());
+    QSaveFile out(configFile());
+    if (!out.open(QIODevice::WriteOnly) || !out.setPermissions(userOnly) ||
+        out.write(QJsonDocument(all).toJson()) < 0 || !out.commit()) {
+        fail(tr("Could not save host access settings")); return false;
+    }
+    cancel(); m_network.clearConnectionCache(); m_endpoint = url; m_token = token; m_pin = pin;
+    m_statsTimer.setInterval(2000);
+    m_stats.clear(); m_status = tr("Connecting to host stats…");
+    emit configChanged(); emit statsChanged(); refresh(); return true;
+}
+void CrimsonStatus::setVisible(bool visible) {
+    m_visible = visible;
+    if (visible) { refreshLocal(); m_statsTimer.start(); refresh(); }
+    else { m_statsTimer.stop(); cancel(); }
+}
+void CrimsonStatus::fail(QString message) {
+    m_stats.clear(); m_status = message;
+    m_statsTimer.setInterval(qMin(30000, qMax(4000, m_statsTimer.interval() * 2)));
+    emit statsChanged();
+}
+QVariantMap CrimsonStatus::parseStats(const QByteArray& bytes, QString* error) {
+    if (bytes.size() > 65536) { *error = "Oversized host stats response"; return {}; }
+    QJsonParseError e; auto doc = QJsonDocument::fromJson(bytes, &e);
+    if (e.error != QJsonParseError::NoError || !doc.isObject()) { *error = "Invalid host stats response"; return {}; }
+    auto obj = doc.object(); QVariantMap result;
+    const QStringList keys = {"cpu_percent","cpu_temp_c","ram_used_bytes","ram_total_bytes","ram_percent",
+        "gpu_percent","gpu_encoder_percent","gpu_temp_c","vram_used_bytes","vram_total_bytes","vram_percent","net_rx_bps","net_tx_bps"};
+    bool recognized = false;
+    for (const auto& key : keys) {
+        auto v = obj.value(key); recognized |= obj.contains(key);
+        double n = v.toDouble(-1);
+        if (!v.isDouble() || !std::isfinite(n) || n < 0 || (key.endsWith("percent") && n > 100)) continue;
+        result[key] = n;
+    }
+    for (const auto& prefix : {QString("ram"), QString("vram")}) {
+        double total = result.value(prefix + "_total_bytes").toDouble();
+        if (total <= 0) { result.remove(prefix + "_percent"); result.remove(prefix + "_used_bytes"); }
+        else if (result.contains(prefix + "_used_bytes")) {
+            double used = qMin(result.value(prefix + "_used_bytes").toDouble(), total);
+            result[prefix + "_used_bytes"] = used; result[prefix + "_percent"] = used * 100 / total;
+        }
+    }
+    if (!recognized) { *error = "Host does not expose the expected Vibepollo stats fields"; return {}; }
+    error->clear(); return result;
+}
+void CrimsonStatus::refresh() {
+    if (!m_visible || m_reply || !configured()) return;
+    QUrl url(m_endpoint); url.setPath("/api/host/stats");
+    QNetworkRequest req(url);
+    req.setAttribute(QNetworkRequest::RedirectPolicyAttribute, QNetworkRequest::ManualRedirectPolicy);
+    req.setTransferTimeout(3000);
+    req.setRawHeader("Authorization", "Bearer " + m_token.toUtf8());
+    req.setRawHeader("Accept", "application/json");
+    auto reply = m_network.get(req); reply->setReadBufferSize(65536); m_reply = reply;
+    auto data = std::make_shared<QByteArray>();
+    auto invalidPin = std::make_shared<bool>(false);
+    auto oversized = std::make_shared<bool>(false);
+    auto certMatches = [this, reply] {
+        return normalizedPin(QString::fromLatin1(reply->sslConfiguration().peerCertificate().digest(QCryptographicHash::Sha256).toHex())) == m_pin;
+    };
+    connect(reply, &QNetworkReply::encrypted, this, [this, reply, certMatches, invalidPin] {
+        if (!m_pin.isEmpty() && !certMatches()) { *invalidPin = true; reply->abort(); }
+    });
+    connect(reply, &QNetworkReply::sslErrors, this, [this, reply, certMatches](const QList<QSslError>& errors) {
+        if (m_pin.isEmpty() || !certMatches()) return;
+        for (const auto& e : errors) {
+            if (e.error() != QSslError::SelfSignedCertificate && e.error() != QSslError::SelfSignedCertificateInChain &&
+                e.error() != QSslError::CertificateUntrusted && e.error() != QSslError::HostNameMismatch) return;
+        }
+        reply->ignoreSslErrors(errors); // Only this explicitly pinned host certificate.
+    });
+    connect(reply, &QNetworkReply::readyRead, this, [reply, data, oversized] {
+        if (*oversized || reply->isFinished()) return;
+        if (data->size() + reply->bytesAvailable() > 65536) { *oversized = true; reply->abort(); return; }
+        data->append(reply->readAll());
+    });
+    connect(reply, &QNetworkReply::finished, this, [this, reply, data, invalidPin, oversized] {
+        m_reply = nullptr;
+        int status = reply->attribute(QNetworkRequest::HttpStatusCodeAttribute).toInt();
+        if (*oversized) fail(tr("Host stats response exceeded the size limit"));
+        else if (*invalidPin) fail(tr("Host certificate changed; verify the saved fingerprint"));
+        else if (status == 401 || status == 403) fail(tr("Host stats access denied: check the read-only token"));
+        else if (status == 404) fail(tr("This host does not provide Vibepollo hardware stats"));
+        else if (reply->error() == QNetworkReply::SslHandshakeFailedError) fail(tr("Verify the host certificate fingerprint in Configure"));
+        else if (reply->error() != QNetworkReply::NoError || status != 200) fail(tr("Host stats unavailable: check connection and realtime stats setting"));
+        else {
+            data->append(reply->readAll()); QString error;
+            auto parsed = parseStats(*data, &error);
+            if (!error.isEmpty()) fail(error);
+            else { m_statsTimer.setInterval(2000); m_stats = parsed; m_status = tr("HOST • received %1").arg(QDateTime::currentDateTime().toString("hh:mm:ss")); emit statsChanged(); }
+        }
+        reply->deleteLater();
+    });
+    // Absolute request bound even if a peer keeps sending occasional bytes.
+    QTimer::singleShot(3500, reply, [reply] { if (!reply->isFinished()) reply->abort(); });
+}
+QVariantMap CrimsonStatus::readLocal(const QString& root) {
+    QVariantMap out; QStringList networks;
+    for (const auto& name : QDir(root + "/class/net").entryList(QDir::Dirs | QDir::NoDotAndDotDot)) {
+        if (name == "lo" || read(root + "/class/net/" + name + "/operstate") != "up") continue;
+        networks << name;
+    }
+    out["connected"] = !networks.isEmpty(); out["network"] = networks.isEmpty() ? tr("No active network link") : networks.join(", ");
+    // Link status is intentionally not presented as internet reachability.
+    out["batteryPercent"] = -1; out["batteryState"] = tr("Battery unavailable");
+    for (const auto& name : QDir(root + "/class/power_supply").entryList(QDir::Dirs | QDir::NoDotAndDotDot)) {
+        const auto base = root + "/class/power_supply/" + name + "/";
+        if (read(base + "type") != "Battery" || read(base + "present") == "0") continue;
+        bool ok; int cap = read(base + "capacity").toInt(&ok);
+        if (ok && cap >= 0 && cap <= 100) out["batteryPercent"] = cap;
+        const auto state = read(base + "status"); out["batteryState"] = state.isEmpty() ? tr("Unknown") : state; break;
+    }
+    return out;
+}
+void CrimsonStatus::refreshLocal() {
+    m_local = readLocal(); m_local["wifiSignal"] = -1; emit localChanged();
+    if (m_wifi.state() == QProcess::NotRunning) {
+        m_wifi.start("nmcli", {"-t", "--escape", "no", "-f", "ACTIVE,SIGNAL,SSID", "device", "wifi", "list", "--rescan", "no"});
+        QTimer::singleShot(2000, &m_wifi, [this] { if (m_wifi.state() != QProcess::NotRunning) m_wifi.kill(); });
+    }
+}
+
+static void registerCrimsonStatus() {
+    qmlRegisterSingletonType<CrimsonStatus>("CrimsonStatus", 1, 0, "CrimsonStatus",
+        [](QQmlEngine*, QJSEngine*) -> QObject* { return new CrimsonStatus(); });
+}
+Q_COREAPP_STARTUP_FUNCTION(registerCrimsonStatus)
